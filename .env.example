# Frontend + Vite
VITE_REQUIRE_AUTH=true
VITE_AUTH_URL=http://localhost:3000
VITE_AUTH_PROXY_TARGET=http://localhost:8787

# Better Auth server
BETTER_AUTH_URL=http://localhost:8787
BETTER_AUTH_SECRET=replace-with-a-32-char-secret-before-production
COOKFLOW_FRONTEND_URL=http://localhost:3000
AUTH_PORT=8787

# MySQL / Hostinger database
# Leave blank to use the in-memory adapter during local development.
# Fill in all five vars to enable persistent storage (required for production).
DB_HOST=localhost
DB_PORT=3306
DB_USER=cookflow_user
DB_PASSWORD=replace-with-your-db-password
DB_NAME=cookflow
